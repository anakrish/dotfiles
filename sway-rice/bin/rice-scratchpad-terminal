#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Toggle a floating "scratchpad" terminal in sway.

Behaviour (real show/hide toggle):
  * Window in sway's __i3_scratch → show it on the current workspace, floating.
  * Window visible on a workspace → move it to __i3_scratch (hide).
  * Window does not exist → spawn GNOME Terminal + persistent tmux session, wait for
    it to appear, then float and focus it. Next invocation hides it.
"""

import json
import subprocess
import sys
import time

APP_ID = "rice-scratchpad"
TITLE  = "Scratchpad"
SELECTOR = f'[title="^{TITLE}$"]'


def sway_json(msg_type: str):
    try:
        out = subprocess.run(
            ["swaymsg", "-t", msg_type],
            capture_output=True, text=True, check=True,
        ).stdout
        return json.loads(out)
    except Exception:
        return None


def swaymsg(*args: str):
    subprocess.run(["swaymsg", *args], capture_output=True, text=True)


def find_node_ids(node) -> list[int]:
    ids: list[int] = []
    if node.get("app_id") == APP_ID or node.get("name") == TITLE:
        ids.append(node["id"])
    for child in node.get("nodes", []) + node.get("floating_nodes", []):
        ids.extend(find_node_ids(child))
    return ids


def get_scratch_ws(tree):
    for output in tree.get("nodes", []):
        for ws in output.get("nodes", []):
            if ws.get("name") == "__i3_scratch":
                return ws
    return None


def main() -> int:
    tree = sway_json("get_tree")
    if tree is None:
        print("sway is not reachable", file=sys.stderr)
        return 1

    scratch_ws    = get_scratch_ws(tree)
    in_scratch    = find_node_ids(scratch_ws) if scratch_ws else []
    all_ids       = find_node_ids(tree)
    on_workspace  = [i for i in all_ids if i not in in_scratch]

    if in_scratch:
        # Bring from scratchpad to current workspace.
        swaymsg(f"{SELECTOR} scratchpad show")
        swaymsg(f"{SELECTOR} floating enable")
        return 0

    if on_workspace:
        # Hide — move back to the scratchpad.
        swaymsg(f"{SELECTOR} move scratchpad")
        return 0

    # Window doesn't exist yet — spawn it.
    subprocess.Popen([
        "gnome-terminal",
        "--class", APP_ID,
        "--title", TITLE,
        "--geometry", "110x30",
        "--", "tmux", "new-session", "-A", "-s", "scratchpad",
    ])

    # Wait up to 4 s for the window to appear, then float and focus.
    for _ in range(40):
        tree = sway_json("get_tree")
        if tree and find_node_ids(tree):
            swaymsg(f"{SELECTOR} floating enable")
            swaymsg(f"{SELECTOR} focus")
            return 0
        time.sleep(0.1)

    return 0


if __name__ == "__main__":
    sys.exit(main())
