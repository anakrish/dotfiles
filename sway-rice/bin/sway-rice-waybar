#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Single-instance waybar launcher for sway-rice.
# Holds an advisory flock so concurrent launchers (from sway reload or an
# autostart entry) can't stack two bars.
set -euo pipefail

config="${XDG_CONFIG_HOME:-$HOME/.config}/waybar/config"
style="${XDG_CONFIG_HOME:-$HOME/.config}/waybar/style.css"

if ! command -v waybar >/dev/null 2>&1; then
    echo "waybar is not installed" >&2
    exit 1
fi

lock_file="${XDG_RUNTIME_DIR:-/tmp}/sway-rice-waybar.lock"
if command -v flock >/dev/null 2>&1; then
    exec 9>"$lock_file"
    if ! flock -n 9; then
        exit 0
    fi
fi

if command -v pgrep >/dev/null 2>&1; then
    while IFS= read -r pid; do
        [ -n "$pid" ] || continue
        [ "$pid" != "$$" ] || continue
        kill "$pid" 2>/dev/null || true
    done < <(pgrep -xu "$(id -u)" waybar || true)
fi

exec waybar -c "$config" -s "$style"
