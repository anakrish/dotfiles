# sway config — part of the sway-rice profile
# https://github.com/anakrish/dotfiles
#
# Keybindings mirror niri-rice as closely as possible so switching between
# the two profiles requires no relearning. $mod == Super.

# ── Variables ─────────────────────────────────────────────────────────────────
set $mod   Mod4
set $term  alacritty
set $menu  fuzzel
set $lock  swaylock -F -c 2e3440

# ── Input ─────────────────────────────────────────────────────────────────────
input type:keyboard {
    # Fetch xkb settings from org.freedesktop.locale1 (set via localectl).
    # Override here if needed, e.g.:
    #   xkb_layout us
    #   xkb_options ctrl:nocaps
    repeat_delay  250
    repeat_rate   40
}

input type:touchpad {
    tap             enabled
    natural_scroll  enabled
    dwt             enabled
}

input type:pointer {
    accel_profile flat
}

# ── Output ────────────────────────────────────────────────────────────────────
# Default background colour (matches waybar/mako/fuzzel theme).
# alacritty-theme-switch updates this line; keep the exact format.
output * bg #2e3440 solid_color

# ── Hyper-V / VM rendering note ───────────────────────────────────────────────
# On Hyper-V the DRM device is not fully exposed to wlroots.
# Set WLR_RENDERER=pixman (and optionally WLR_NO_HARDWARE_CURSORS=1) before
# launching sway.  The sway-rice installer adds a sway-session wrapper that
# does this automatically; use that instead of launching sway directly.

# ── Appearance ────────────────────────────────────────────────────────────────
gaps inner 12
smart_gaps  on
smart_borders on

default_border          pixel 3
default_floating_border pixel 3
hide_edge_borders smart

# Window border colours (Nord defaults; alacritty-theme-switch updates these).
# Format: class  border  background  text   indicator  child_border
# alacritty-theme-switch rewrites these lines; keep the exact layout/spacing.
client.focused          #81a1c1 #3b4252 #d8dee9 #88c0d0 #81a1c1
client.focused_inactive #4c566a #2e3440 #d8dee9 #4c566a #4c566a
client.unfocused        #3b4252 #2e3440 #4c566a #3b4252 #3b4252
client.urgent           #bf616a #bf616a #d8dee9 #bf616a #bf616a

# Corner radius (requires sway fork with corner-radius, or remove if unsupported)
# corner_radius 12

font pango:JetBrainsMono Nerd Font Mono 11

# ── XWayland ──────────────────────────────────────────────────────────────────
xwayland enable

# DISPLAY exported by the session wrapper matches this; X11 clients work automatically.
exec_always export DISPLAY=:0

# ── Startup daemons ───────────────────────────────────────────────────────────
# Clipboard history daemon.
exec $HOME/.local/bin/rice-clipboard-daemon

# Waybar — use the wrapper to avoid duplicate bars on compositor reload.
exec $HOME/.local/bin/sway-rice-waybar

# Screen blank + lock after inactivity (standalone sessions only).
# Detects virtualised/nested environment: if SWAYSOCK already existed before
# sway started (i.e. we are nested) or if a host compositor is running,
# swayidle is still launched but blanking targets the sway outputs rather than
# a parent session.  For a VM where the host owns idle, you may want to
# comment this out.
exec swayidle -w \
    timeout 300 '$HOME/.local/bin/sway-rice-lock' \
    timeout 330 'swaymsg "output * dpms off"' \
    resume      'swaymsg "output * dpms on"'

# ── Floating window rules ─────────────────────────────────────────────────────
# rice-scratchpad terminal — managed by rice-scratchpad-terminal script.
for_window [app_id="rice-scratchpad"]     floating enable, resize set 900 600

# Firefox picture-in-picture player.
for_window [app_id="firefox"  title="^Picture-in-Picture$"] floating enable, sticky enable
for_window [app_id="org.mozilla.firefox" title="^Picture-in-Picture$"] floating enable, sticky enable

# Pavucontrol audio mixer.
for_window [app_id="org.pulseaudio.pavucontrol"] floating enable

# ── Floating drag modifier ────────────────────────────────────────────────────
floating_modifier $mod normal

# ── Key bindings — applications ───────────────────────────────────────────────
bindsym $mod+t            exec $term
bindsym $mod+Shift+t      exec $HOME/.local/bin/alacritty-theme-switch
bindsym $mod+d            exec $menu
bindsym $mod+Shift+d      exec $HOME/.local/bin/sway-workspace-picker focus
bindsym $mod+Ctrl+d       exec $HOME/.local/bin/sway-workspace-picker move
bindsym $mod+Shift+n      exec $HOME/.local/bin/sway-rename-workspace
bindsym $mod+grave        exec $HOME/.local/bin/rice-scratchpad-terminal
bindsym $mod+Shift+s      exec $HOME/.local/bin/rice-screenshot-picker
bindsym $mod+Shift+c      exec $HOME/.local/bin/rice-clipboard-picker
bindsym $mod+b            exec microsoft-edge
bindsym $mod+e            exec nautilus
bindsym $mod+Shift+q      exec $HOME/.local/bin/sway-rice-lock
bindsym $mod+q            kill

# Quick named workspaces (created on demand, same as niri-rice Mod+- / Mod+=)
bindsym $mod+minus        exec $HOME/.local/bin/sway-quick-workspace web
bindsym $mod+equal        exec $HOME/.local/bin/sway-quick-workspace chat

# ── Key bindings — WM actions ─────────────────────────────────────────────────
# Focus — HJKL + arrows
bindsym $mod+h            focus left
bindsym $mod+j            focus down
bindsym $mod+k            focus up
bindsym $mod+l            focus right
bindsym $mod+Left         focus left
bindsym $mod+Down         focus down
bindsym $mod+Up           focus up
bindsym $mod+Right        focus right

# Move — Ctrl+HJKL + arrows
bindsym $mod+Ctrl+h       move left
bindsym $mod+Ctrl+j       move down
bindsym $mod+Ctrl+k       move up
bindsym $mod+Ctrl+l       move right
bindsym $mod+Ctrl+Left    move left
bindsym $mod+Ctrl+Down    move down
bindsym $mod+Ctrl+Up      move up
bindsym $mod+Ctrl+Right   move right

# Focus output — Shift+HJKL (mirrors niri-rice monitor focus)
bindsym $mod+Shift+h      focus output left
bindsym $mod+Shift+j      focus output down
bindsym $mod+Shift+k      focus output up
bindsym $mod+Shift+l      focus output right

# Move to output — Ctrl+Shift+HJKL
bindsym $mod+Ctrl+Shift+h move container to output left;  focus output left
bindsym $mod+Ctrl+Shift+j move container to output down;  focus output down
bindsym $mod+Ctrl+Shift+k move container to output up;    focus output up
bindsym $mod+Ctrl+Shift+l move container to output right; focus output right

# Workspace navigation (Mod+U/I = prev/next, mirrors niri Mod+Page_Up/Down)
bindsym $mod+u            workspace prev
bindsym $mod+i            workspace next
bindsym $mod+Page_Up      workspace prev
bindsym $mod+Page_Down    workspace next
bindsym $mod+Ctrl+u       move container to workspace prev; workspace prev
bindsym $mod+Ctrl+i       move container to workspace next; workspace next

# Numbered workspaces 1-9
bindsym $mod+1            workspace number 1
bindsym $mod+2            workspace number 2
bindsym $mod+3            workspace number 3
bindsym $mod+4            workspace number 4
bindsym $mod+5            workspace number 5
bindsym $mod+6            workspace number 6
bindsym $mod+7            workspace number 7
bindsym $mod+8            workspace number 8
bindsym $mod+9            workspace number 9

bindsym $mod+Ctrl+1       move container to workspace number 1
bindsym $mod+Ctrl+2       move container to workspace number 2
bindsym $mod+Ctrl+3       move container to workspace number 3
bindsym $mod+Ctrl+4       move container to workspace number 4
bindsym $mod+Ctrl+5       move container to workspace number 5
bindsym $mod+Ctrl+6       move container to workspace number 6
bindsym $mod+Ctrl+7       move container to workspace number 7
bindsym $mod+Ctrl+8       move container to workspace number 8
bindsym $mod+Ctrl+9       move container to workspace number 9

# Fullscreen / layout
bindsym $mod+f            fullscreen toggle
bindsym $mod+Shift+f      fullscreen toggle global
bindsym $mod+m            fullscreen toggle

# Split orientation (sway-specific; no niri equivalent)
bindsym $mod+backslash    split horizontal
bindsym $mod+minus        split vertical
# Note: $mod+minus is overloaded above for "web" workspace — the split binding
# is superseded. Uncomment one or the other based on preference:
# bindsym $mod+minus  split vertical

# Layout cycling (sway-specific)
bindsym $mod+Shift+e      layout toggle split tabbed stacking

# Floating toggle
bindsym $mod+Shift+space  floating toggle
bindsym $mod+space        focus mode_toggle

# ── Resize mode ───────────────────────────────────────────────────────────────
mode "resize" {
    bindsym h              resize shrink width  20px
    bindsym j              resize grow   height 20px
    bindsym k              resize shrink height 20px
    bindsym l              resize grow   width  20px
    bindsym Left           resize shrink width  20px
    bindsym Down           resize grow   height 20px
    bindsym Up             resize shrink height 20px
    bindsym Right          resize grow   width  20px
    bindsym Return         mode "default"
    bindsym Escape         mode "default"
    bindsym $mod+r         mode "default"
}
bindsym $mod+r mode "resize"

# ── Media / brightness keys ───────────────────────────────────────────────────
bindsym --locked XF86AudioRaiseVolume  exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0
bindsym --locked XF86AudioLowerVolume  exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-
bindsym --locked XF86AudioMute         exec wpctl set-mute   @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute      exec wpctl set-mute   @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86AudioPlay         exec playerctl play-pause
bindsym --locked XF86AudioPause        exec playerctl play-pause
bindsym --locked XF86AudioStop         exec playerctl stop
bindsym --locked XF86AudioPrev         exec playerctl previous
bindsym --locked XF86AudioNext         exec playerctl next
bindsym --locked XF86MonBrightnessUp   exec brightnessctl --class=backlight set +10%
bindsym --locked XF86MonBrightnessDown exec brightnessctl --class=backlight set 10%-

# ── Screen lock ───────────────────────────────────────────────────────────────
bindsym $mod+Shift+Ctrl+l exec $HOME/.local/bin/sway-rice-lock

# ── Reload / exit ─────────────────────────────────────────────────────────────
bindsym $mod+Shift+r      reload
bindsym $mod+Shift+Ctrl+e exec swaynag -t warning \
    -m 'Exit sway?' \
    -b 'Yes' 'swaymsg exit'

# ── No sway-bar — waybar handles everything ───────────────────────────────────
bar {
    swaybar_command true
}
