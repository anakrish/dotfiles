{
  "layer": "top",
  "position": "top",
  "spacing": 6,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "modules-left": [
    "sway/workspaces",
    "wlr/taskbar"
  ],
  "modules-center": [
    "sway/window"
  ],
  "modules-right": [
    "mpris",
    "idle_inhibitor",
    "pulseaudio",
    "network",
    "custom/system",
    "backlight",
    "battery",
    "clock",
    "tray"
  ],
  "sway/workspaces": {
    "disable-scroll": false,
    "all-outputs": false,
    "format": "{name}",
    "on-click": "activate",
    "persistent-workspaces": {}
  },
  "sway/window": {
    "max-length": 80,
    "tooltip": true
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 18,
    "tooltip-format": "{title}",
    "active-first": true,
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": [
      "waybar"
    ]
  },
  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} {dynamic}",
    "format-stopped": "",
    "dynamic-len": 36,
    "tooltip-format": "{player}: {title} - {artist}",
    "player-icons": {
      "default": "",
      "spotify": "",
      "firefox": "",
      "chromium": ""
    },
    "status-icons": {
      "playing": "",
      "paused": "",
      "stopped": ""
    },
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click-middle": "playerctl previous"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    },
    "tooltip-format-activated": "Idle inhibit on",
    "tooltip-format-deactivated": "Idle inhibit off"
  },
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-bluetooth": "{volume}% {icon} ",
    "format-muted": "muted ",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "scroll-step": 2,
    "on-click": "pavucontrol"
  },
  "network": {
    "format-wifi": "{signalStrength}% ",
    "format-ethernet": "{ifname} ",
    "format-disconnected": "offline ⚠",
    "format-alt": "{essid} {signalStrength}% ",
    "tooltip-format": "{essid}\n{ifname}: {ipaddr}/{cidr}\nvia {gwaddr}"
  },
  "custom/system": {
    "exec": "$HOME/.local/bin/waybar-system",
    "interval": 3,
    "return-type": "json",
    "format": "{}",
    "tooltip": true
  },
  "backlight": {
    "device": "amdgpu_bl1",
    "format": "{percent}% {icon}",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ]
  },
  "battery": {
    "bat": "BAT0",
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% ",
    "format-plugged": "{capacity}% ",
    "format-full": "full ",
    "format-alt": "{time} {icon}",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ]
  },
  "clock": {
    "format": "{:%a %b %d  %I:%M %p}",
    "format-alt": "{:%Y-%m-%d  %H:%M}",
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "tray": {
    "icon-size": 18,
    "spacing": 8
  }
}
