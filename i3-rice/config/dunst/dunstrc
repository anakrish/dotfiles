[global_config]
    font = JetBrainsMono Nerd Font Mono 11
    geometry = 460x190+18+18
    shrink = yes
    transparency = 10
    indicate_hidden = yes
    sort = yes
    idle_threshold = 120
    follow = keyboard
    show_age_threshold = 60
    word_wrap = yes
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    line_height = 0
    separator_height = 2
    padding = 16
    horizontal_padding = 18
    separator_color = frame
    startup_notification = false
    dmenu = /usr/bin/dmenu -p dunst:
    browser = /usr/bin/xdg-open
    icon_position = left
    max_icon_size = 48
    icon_path = /usr/share/icons/Papirus-Dark/48x48/apps/:/usr/share/icons/hicolor/48x48/apps/
    frame_width = 4
    corner_radius = 16
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 1
    ellipsize = middle

[urgency_low]
    background = "#3b4252e8"
    foreground = "#d8dee9ff"
    frame_color = "#88c0d0cc"
    timeout = 3

[urgency_normal]
    background = "#2e3440f6"
    foreground = "#d8dee9ff"
    frame_color = "#b48eadff"
    timeout = 5

[urgency_critical]
    background = "#3b4252fa"
    foreground = "#d8dee9ff"
    frame_color = "#bf616aff"
    timeout = 0
