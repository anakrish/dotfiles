; polybar config for i3-rice
; Nord-themed top bar matching niri-rice waybar layout
; Colors are rewritten by alacritty-theme-switch

include-file = ~/.config/polybar/colors.ini

[bar/main]
width = 100%:-24
offset-x = 12
offset-y = 8
height = 34
radius = 12
fixed-center = true
bottom = false

background = ${colors.bg}da
foreground = ${colors.fg}

line-size = 3
line-color = ${colors.accent}

border-size = 0
padding-left = 1
padding-right = 1
module-margin-left = 1
module-margin-right = 1

font-0 = JetBrainsMono Nerd Font Mono:size=10;2
font-1 = Font Awesome 6 Free:style=Solid:size=10;2
font-2 = Font Awesome 6 Brands:size=10;2

modules-left = i3 xwindow
modules-center = mpris
modules-right = pulseaudio network system battery date tray

tray-position = right
tray-padding = 4
tray-background = ${colors.bg}

wm-restack = i3
override-redirect = true

cursor-click = pointer
cursor-scroll = ns-resize

[module/i3]
type = internal/i3
format = <label-state> <label-mode>
index-sort = true
wrapping-scroll = false
strip-wsnumbers = false
pin-workspaces = false

label-focused = %name%
label-focused-background = ${colors.surface}
label-focused-foreground = ${colors.fg}
label-focused-underline = ${colors.accent}
label-focused-padding = 8
label-focused-margin = 2

label-unfocused = %name%
label-unfocused-foreground = ${colors.muted}
label-unfocused-padding = 6
label-unfocused-margin = 2

label-visible = %name%
label-visible-foreground = ${colors.accent-alt}
label-visible-underline = ${colors.accent-alt}
label-visible-padding = 6
label-visible-margin = 2

label-urgent = %name%
label-urgent-background = ${colors.error}
label-urgent-foreground = ${colors.fg}
label-urgent-padding = 6
label-urgent-margin = 2

label-mode-padding = 4
label-mode-foreground = ${colors.fg}
label-mode-background = ${colors.accent}

[module/xwindow]
type = internal/xwindow
label = %title:0:80:...%
label-foreground = ${colors.muted}
format-padding = 2

[module/pulseaudio]
type = internal/pulseaudio
format-volume = <ramp-volume> <label-volume>
label-volume = %percentage%%
label-volume-foreground = ${colors.fg}

ramp-volume-0 = 
ramp-volume-1 = 
ramp-volume-2 = 
ramp-volume-foreground = ${colors.accent-alt}

label-muted = 
label-muted-foreground = ${colors.muted}

format-volume-padding = 2
format-muted-padding = 2

[module/network]
type = internal/network
interface-type = any
interval = 5

format-connected = <label-connected>
format-disconnected = <label-disconnected>

label-connected =  %{A1:alacritty -e nmtui &:}%ifname% %local_ip%%{A}
label-connected-foreground = ${colors.green}
label-connected-padding = 2

label-disconnected = 
label-disconnected-foreground = ${colors.muted}
label-disconnected-padding = 2

[module/system]
type = custom/script
exec = $HOME/.local/bin/polybar-system
interval = 5
format-foreground = ${colors.cyan}
format-padding = 2

[module/battery]
type = internal/battery
battery = BAT0
adapter = AC
full-at = 99
low-at = 15
poll-interval = 30

format-full = <label-full>
format-charging = <animation-charging> <label-charging>
format-discharging = <ramp-capacity> <label-discharging>
format-low = <animation-low> <label-low>

label-full = 
label-full-foreground = ${colors.green}
label-full-padding = 2

label-charging = %percentage%%
label-charging-foreground = ${colors.yellow}
label-charging-padding = 1

label-discharging = %percentage%%
label-discharging-padding = 1

label-low = %percentage%%!
label-low-foreground = ${colors.error}

ramp-capacity-0 = 
ramp-capacity-1 = 
ramp-capacity-2 = 
ramp-capacity-3 = 
ramp-capacity-4 = 
ramp-capacity-foreground = ${colors.accent}

animation-charging-0 = 
animation-charging-1 = 
animation-charging-2 = 
animation-charging-foreground = ${colors.yellow}
animation-charging-framerate = 750

animation-low-0 = 
animation-low-1 = 
animation-low-foreground = ${colors.error}
animation-low-framerate = 500

format-charging-padding = 2
format-discharging-padding = 2

[module/date]
type = internal/date
interval = 30
date = %a %b %d
time = %I:%M %p
label =  %date%   %time%
label-foreground = ${colors.fg}
format-padding = 2

[module/mpris]
type = custom/script
exec = playerctl metadata --format '{{ emoji(status) }} {{ title }} - {{ artist }}' 2>/dev/null || true
exec-if = playerctl status 2>/dev/null | grep -qv 'No players found'
interval = 2
format-padding = 2
format-foreground = ${colors.accent}
click-left = playerctl play-pause
click-right = playerctl next
scroll-up = playerctl next
scroll-down = playerctl previous

[module/tray]
type = internal/tray
tray-size = 18%
tray-padding = 4
