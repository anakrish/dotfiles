#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -euo pipefail

prev_hash=""

while true; do
    text="$(xclip -o -selection clipboard 2>/dev/null || true)"
    if [ -n "$text" ]; then
        hash="$(printf '%s' "$text" | md5sum | cut -d' ' -f1)"
        if [ "$hash" != "$prev_hash" ]; then
            prev_hash="$hash"
            printf '%s' "$text" | "$HOME/.local/bin/rice-clipboard-store"
        fi
    fi
    sleep 0.5
done
