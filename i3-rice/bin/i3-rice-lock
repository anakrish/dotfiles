#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -euo pipefail

bg_color="2e3440"
i3_cfg="${XDG_CONFIG_HOME:-$HOME/.config}/i3/config"

if [ -f "$i3_cfg" ]; then
    extracted="$(grep -oP '# i3-rice: bg=#\K[0-9a-fA-F]{6}' "$i3_cfg" | head -1 || true)"
    [ -n "$extracted" ] && bg_color="$extracted"
fi

exec i3lock -c "$bg_color"
