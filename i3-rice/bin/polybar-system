#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Outputs: " cpu%   mem%   temp°" for polybar custom/script module
set -euo pipefail

cpu="$(grep -m1 'cpu ' /proc/stat | awk '{idle=$5+$6; total=0; for(i=2;i<=NF;i++) total+=$i; printf "%d", (1-idle/total)*100}')"
mem="$(awk '/MemTotal/{t=$2}/MemAvailable/{a=$2} END{printf "%d",(t-a)/t*100}' /proc/meminfo)"
temp="$(cat /sys/class/thermal/thermal_zone*/temp 2>/dev/null | sort -n | tail -1 | awk '{printf "%d",$1/1000}' || echo "--")"

echo " ${cpu}%   ${mem}%   ${temp}°"
