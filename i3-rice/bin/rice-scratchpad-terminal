#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Toggle floating scratchpad terminal in i3."""
import json
import subprocess
import sys
import time

APP_CLASS = "rice-scratchpad"
TITLE     = "Scratchpad"


def i3_json(msg_type):
    try:
        out = subprocess.run(
            ["i3-msg", "-t", msg_type],
            capture_output=True, text=True, check=True
        ).stdout
        return json.loads(out)
    except Exception:
        return None


def i3msg(*args):
    subprocess.run(["i3-msg"] + list(args), capture_output=True, text=True)


def find_ids(node):
    ids = []
    wp = node.get("window_properties") or {}
    if wp.get("class") == APP_CLASS or node.get("name") == TITLE:
        ids.append(node["id"])
    for child in node.get("nodes", []) + node.get("floating_nodes", []):
        ids.extend(find_ids(child))
    return ids


def get_scratch(tree):
    for output in tree.get("nodes", []):
        for ws in output.get("nodes", []):
            if ws.get("name") == "__i3_scratch":
                return ws
    return None


def main():
    tree = i3_json("get_tree")
    if not tree:
        print("i3 not reachable", file=sys.stderr)
        return 1

    scratch   = get_scratch(tree)
    in_scratch = find_ids(scratch) if scratch else []
    all_ids    = find_ids(tree)
    on_ws      = [i for i in all_ids if i not in in_scratch]

    if in_scratch:
        i3msg('[title="^{}$"] scratchpad show'.format(TITLE))
        i3msg('[title="^{}$"] floating enable'.format(TITLE))
        return 0

    if on_ws:
        i3msg('[title="^{}$"] move scratchpad'.format(TITLE))
        return 0

    # Spawn new scratchpad terminal
    subprocess.Popen([
        "gnome-terminal",
        "--class", APP_CLASS,
        "--title", TITLE,
        "--geometry", "110x30",
        "--",
        "tmux", "new-session", "-A", "-s", "scratchpad"
    ])

    for _ in range(40):
        tree = i3_json("get_tree")
        if tree and find_ids(tree):
            i3msg('[title="^{}$"] floating enable'.format(TITLE))
            i3msg('[title="^{}$"] focus'.format(TITLE))
            return 0
        time.sleep(0.1)

    return 0


if __name__ == "__main__":
    sys.exit(main())
